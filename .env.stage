# Stage environment — Drupal data from stage.contentfiles.babson.edu.
# (The built app is hosted at test-www.babson.edu, which does not serve JSON:API.)
# Safe to commit — use .env.stage.local for real DEV_SEARCHSTAX_TOKEN
DEV_DRUPAL_ENDPOINT=https://stage.contentfiles.babson.edu/jsonapi/
DEV_SEARCHSTAX_ENDPOINT=https://searchcloud-18-us-east-1.searchstax.com/29847/babsonbricksdatastage-7988/emselect
DEV_SEARCHSTAX_TOKEN=your-staging-token-here
DEV_HERO_IMAGE=https://stage.contentfiles.babson.edu/sites/default/files/2026-03/find-my-brick-hero.jpg
DEV_PLACEHOLDER_IMAGE=https://stage.contentfiles.babson.edu/sites/default/files/2026-03/coming-soon-gray.jpg

# New Relic Browser app bricks-test (account 1659938). The browser license key is
# public: it only lets pages send data, so it is safe to commit.
DEV_NEWRELIC_APP_ID=1120575188
DEV_NEWRELIC_LICENSE_KEY=76b0a2d991
